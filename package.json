{
  "name": "auto-music-vid-gen",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "comfy": "node scripts/start-comfy.js",
    "mvid": "node scripts/run-mvid.js",
    "mvid:lyrics": "node scripts/02_0_generate-lyrics+song+scene+keyframes.js --kids-hit",
    "mvid:chars": "node scripts/02_0_generate-lyrics+song+scene+keyframes.js --kids-hit --chars-only",
    "mvid:animate": "node scripts/02_1_animate-keyframes.js --kids-hit",
    "mvid:stitch": "node scripts/02_2_stitch-song.js --loop-fill",
    "mvid:validate": "node scripts/validate-continuity.js",
    "mvid:classic": "node scripts/run-mvid.js --classic",
    "mvid:classic:lyrics": "node scripts/02_0_generate-lyrics+song+scene+keyframes.js",
    "mvid:classic:animate": "node scripts/02_1_animate-keyframes.js",
    "mvid:classic:stitch": "node scripts/02_2_stitch-song.js",
    "song": "node scripts/00-generate-song.js",
    "nursery": "node scripts/01-generate-lyrics+songx10.js",
    "generate:adam:master": "node scripts/generate-dataset.js --character characters/adam.json --out dataset/adam --master-only --bootstrap-from-text",
    "generate:adam:approve": "node scripts/generate-dataset.js --character characters/adam.json --out dataset/adam --approve-master --master-only",
    "generate:adam": "node scripts/generate-dataset.js --character characters/adam.json --out dataset/adam",
    "train:adam": "node scripts/train-lora.js --train-config train-config-adam.json --character characters/adam.json"
  },
  "dependencies": {
    "ejs": "^6.0.1",
    "express": "^5.2.1",
    "sharp": "^0.35.3"
  },
  "allowScripts": {
    "sharp@0.32.6": true,
    "sharp@0.35.3": true,
    "onnxruntime-node@1.17.3": true
  }
}
