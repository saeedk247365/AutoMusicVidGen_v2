{
  "name": "auto-music-vid-gen",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "song": "node scripts/00-generate-song.js",
    "nursery": "node scripts/01-generate-lyrics+songx10.js",
    "family": "node scripts/02-generate-lyrics+song+scene+keyframesx10.js",
    "family:chars": "node scripts/02-generate-lyrics+song+scene+keyframesx10.js --chars-only",

    "generate:tom:master": "node scripts/generate-dataset.js --character characters/tomchr.json --out dataset/tom --master-only --bootstrap-from-text",
    "generate:tom:approve": "node scripts/generate-dataset.js --character characters/tomchr.json --out dataset/tom --approve-master --master-only",
    "generate:tom": "node scripts/generate-dataset.js --character characters/tomchr.json --out dataset/tom",

    "generate:adam:master": "node scripts/generate-dataset.js --character characters/adam.json --out dataset/adam --master-only --bootstrap-from-text",
    "generate:adam:approve": "node scripts/generate-dataset.js --character characters/adam.json --out dataset/adam --approve-master --master-only",
    "generate:adam": "node scripts/generate-dataset.js --character characters/adam.json --out dataset/adam",

    "train": "node scripts/train-lora.js --character characters/tomchr.json"
  }
}
