# Copy to .env and fill in. Never commit .env.
SALAD_API_KEY=
# After salad:deploy / portal — Gateway URL (https://….salad.cloud)
# Container Gateway port MUST be 8888 (same as image COMFY_PORT / SALAD_COMFY_PORT).
# Local ComfyUI on this PC stays on 8188 — do not change the Salad gateway to 8188.
SALAD_COMFY_URL=
# Management API — org slug from portal URL (https://portal.salad.com/organizations/<ORG>/…)
SALAD_ORG=
SALAD_PROJECT=default
SALAD_CONTAINER=amvg-comfyui
# Image used by scripts/salad-deploy.js
SALAD_IMAGE=ghcr.io/saeedk247365/amvg-comfyui:kids-hit-wan22
# local | salad | split
#   local  — all Comfy on PC
#   salad  — all Comfy on Salad
#   split  — lyrics/stills on local; Wan clips on Salad (recommended)
GPU_BACKEND=split
