<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>mvid — music video studio</title>
  <link rel="stylesheet" href="/static/mvid.css" />
</head>
<body>
  <header class="topbar">
    <div class="brand">mvid</div>
    <div class="project-pill" id="projectPill" title="Active project (restored after restart)">Project: —</div>
    <div class="status" id="statusMsg"><%= initial.statusMessage || "Starting…" %></div>
    <div class="stage-pill" id="stagePill"><%= initial.stage || "idle" %></div>
    <div class="resource-meters" id="resourceMeters" title="Local machine + Salad Cloud usage (updates every 2s)">
      <div class="meter-group" data-scope="local">
        <span class="meter-label">Local</span>
        <span class="meter" data-key="cpu"><span class="meter-bar"></span><span class="meter-txt">CPU —</span></span>
        <span class="meter" data-key="ram"><span class="meter-bar"></span><span class="meter-txt">RAM —</span></span>
        <span class="meter" data-key="gpu"><span class="meter-bar"></span><span class="meter-txt">GPU —</span></span>
      </div>
      <div class="meter-group salad-meters" data-scope="salad">
        <span class="meter-label">Salad</span>
        <span class="meter" data-key="cpu"><span class="meter-bar"></span><span class="meter-txt">CPU —</span></span>
        <span class="meter" data-key="ram"><span class="meter-bar"></span><span class="meter-txt">RAM —</span></span>
        <span class="meter" data-key="gpu"><span class="meter-bar"></span><span class="meter-txt">GPU —</span></span>
      </div>
    </div>
    <label class="auto-toggle" title="Local = all on PC. Salad = all on cloud. Split = prep/stills local, Wan clips on Salad (recommended).">
      GPU
      <select id="gpuBackend">
        <% const gpuB = (initial.gpu && initial.gpu.backend) || "local"; %>
        <option value="local" <%= gpuB === "local" ? "selected" : "" %>>Local</option>
        <option value="split" <%= gpuB === "split" ? "selected" : "" %>>Split (local + Salad Wan)</option>
        <option value="salad" <%= gpuB === "salad" ? "selected" : "" %>>Salad Cloud</option>
      </select>
    </label>
    <label class="auto-toggle" title="Final stills / Wan / stitch size. Preview = current 768×768. YouTube = 1920×1088 (16-aligned ~1080p) for production.">
      Output
      <select id="outputResolution">
        <% const resList = (initial.outputResolutions && initial.outputResolutions.length) ? initial.outputResolutions : [{ id: "preview", label: "Preview 768×768" }, { id: "youtube", label: "YouTube 1920×1088" }]; %>
        <% const curRes = initial.outputResolution || "preview"; %>
        <% resList.forEach(function (p) { %>
          <option value="<%= p.id %>" <%= curRes === p.id ? "selected" : "" %>><%= p.label %></option>
        <% }) %>
      </select>
    </label>
    <label class="auto-toggle song-picker" title="Open a finished batch to review in the tabs">
      Batch
      <select id="batchPicker">
        <option value="">— open batch —</option>
      </select>
    </label>
    <div class="run-controls">
      <button type="button" id="btnContinue" class="btn tiny primary" title="Resume pipeline on the open project">Continue</button>
      <button type="button" id="btnNewProject" class="btn tiny" title="Start a brand-new project">New</button>
      <button type="button" id="btnPause" class="btn" title="Pause generation (kills current worker, holds until Resume)">Pause</button>
      <button type="button" id="btnResume" class="btn" disabled title="Resume after pause">Resume</button>
      <button type="button" id="btnStop" class="btn danger" title="Hard-stop pipeline">Stop</button>
    </div>
    <div class="salad-controls" title="Salad container billing controls">
      <span class="salad-pill" id="saladStatusPill">Salad: —</span>
      <button type="button" id="btnSaladRefresh" class="btn tiny">Status</button>
      <button type="button" id="btnSaladStart" class="btn tiny">Start</button>
      <button type="button" id="btnSaladStop" class="btn tiny danger">Shutdown</button>
    </div>
    <label class="auto-toggle" title="Skip all approval gates">
      <input type="checkbox" id="autoApprove" <%= initial.autoApprove ? "checked" : "" %> />
      Auto-approve all
    </label>
    <div class="actions">
      <button type="button" id="btnReject" class="btn danger" disabled>Regenerate</button>
      <button type="button" id="btnApprove" class="btn primary" disabled>Approve &amp; continue</button>
    </div>
  </header>

  <nav class="tabs" id="tabNav">
    <button type="button" data-tab="setup" class="active">Cast &amp; Scenes</button>
    <button type="button" data-tab="lyrics">Lyrics</button>
    <button type="button" data-tab="song">Song</button>
    <button type="button" data-tab="storyline">Storyline</button>
    <button type="button" data-tab="scenes">Scenes</button>
    <button type="button" data-tab="scripts">Scripts</button>
    <button type="button" data-tab="keyframes">Keyframes</button>
    <button type="button" data-tab="clips">Clips</button>
    <button type="button" data-tab="final">Final</button>
  </nav>

  <main class="panes">
    <section class="pane active" id="pane-setup">
      <p class="hint">Pick cast and rooms first. Optional title/objective lock lyric generation.</p>
      <div class="setup-grid">
        <div>
          <h3>Cast</h3>
          <div id="castList" class="check-list empty">Loading characters…</div>
          <details class="create-box">
            <summary>Create character</summary>
            <input id="newCharName" placeholder="Name" />
            <select id="newCharRole">
              <option value="toddler">toddler</option>
              <option value="helper">helper / mom</option>
              <option value="other">other</option>
            </select>
            <textarea id="newCharAppearance" rows="2" placeholder="Appearance…"></textarea>
            <textarea id="newCharOutfit" rows="2" placeholder="Outfit…"></textarea>
            <button type="button" id="btnCreateChar" class="btn">Save character</button>
          </details>
        </div>
        <div>
          <h3>Scenes</h3>
          <div id="setupScenesList" class="check-list empty">Loading scenes…</div>
        </div>
        <div>
          <h3>Brief (optional locks)</h3>
          <label class="field">Title <input id="setupTitle" placeholder="Song title" /></label>
          <label class="field">Objective <input id="setupObjective" placeholder="One toddler goal" /></label>
          <label class="field">Theme hint <input id="setupTheme" placeholder="e.g. rainy day indoor march" /></label>
        </div>
      </div>
    </section>

    <section class="pane" id="pane-lyrics">
      <p class="hint">Edit lyrics before approving. TITLE / OBJECTIVE lines are kept.</p>
      <textarea id="lyricsText" spellcheck="true" placeholder="Lyrics will appear here…"></textarea>
    </section>

    <section class="pane" id="pane-song">
      <p class="hint">Listen to the generated song, then approve or regenerate.</p>
      <div id="songPlayer" class="empty">No audio yet</div>
    </section>

    <section class="pane" id="pane-storyline">
      <p class="hint">Beat timeline overview. Edit shots on the <strong>Scripts</strong> tab (plain-language cards). Advanced: raw JSON below.</p>
      <div id="storylineView" class="empty">No storyline yet</div>
      <details class="raw-json">
        <summary>Edit raw actions.json</summary>
        <textarea id="planRaw" spellcheck="false"></textarea>
      </details>
    </section>

    <section class="pane" id="pane-scenes">
      <p class="hint">Furnished room plates used by each beat (play lane + midground furniture).</p>
      <div id="scenesGrid" class="grid empty">No scenes yet</div>
    </section>

    <section class="pane" id="pane-scripts">
      <p class="hint">
        Each card is one frozen shot. Edit the story, then <strong>Save scripts</strong> or
        <strong>Remake still</strong> for that shot only (does not regenerate the whole video).
      </p>
      <div class="scripts-toolbar">
        <button type="button" id="btnSaveScripts" class="btn primary">Save scripts</button>
        <span class="meta" id="scriptsSaveStatus"></span>
      </div>
      <div id="scriptsView" class="empty">No scripts yet</div>
    </section>

    <section class="pane" id="pane-keyframes">
      <p class="hint">Composited stills. Remake one shot after editing its script card. Approve to animate with Wan.</p>
      <div id="keyframesGrid" class="grid empty">No keyframes yet</div>
    </section>

    <section class="pane" id="pane-clips">
      <p class="hint">Live preview grows as each Wan clip finishes (with song audio). Individual clips below. Approve when ready to stitch final.mp4.</p>
      <div id="previewPlayer" class="empty">Preview will appear after the first clip…</div>
      <div id="clipsGrid" class="grid empty">No clips yet</div>
    </section>

    <section class="pane" id="pane-final">
      <p class="hint">Final music video.</p>
      <div id="finalPlayer" class="empty">No final yet</div>
    </section>
  </main>

  <footer class="log" id="log"></footer>

  <script>
    window.__MVID_INITIAL__ = <%- JSON.stringify(initial) %>;
  </script>
  <script src="/static/mvid.js"></script>
</body>
</html>
